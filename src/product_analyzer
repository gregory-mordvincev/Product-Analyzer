"""
Project: Product Analyzer
Version: 1.0

Author: Mordvincev Gregory (Мордвинцев Григорий)

Description:
Reads a product sales journal,
analyzes product frequencies,
and generates a sales report.
"""

with open('data/product_list.txt', 'r') as f:
    data = f.read().split('\n')

products = {}
for item in data:
    if not item.isspace() and len(item) > 0:
        if item in products:
            products[item] += 1
        else:
            products[item] = 1

with open('output/report.txt', 'w', encoding='utf-8') as f:
    f.write(f'========== ОТЧЁТ ==========\n\nСтатистика продаж\n')
    for key, value in sorted(products.items(), key=lambda x: (-x[1], x[0])):
        f.write(f'{key}: {value}\n')

print(f'========== ОТЧЁТ ==========\n\nСтатистика продаж\n')
for key, value in sorted(products.items(), key=lambda x: (-x[1], x[0])):
    print(f'{key}: {value}')
